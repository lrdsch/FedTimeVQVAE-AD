% references.bib — submitted Federated TimeVQVAE-AD paper (IEEEtran)
%
% PROVENANCE — regenerated on 2026-08-19.
% Every record except schiavo2026fedtimevqvae was downloaded from DBLP using
% https://dblp.org/rec/<record-key>.bib?param=1. This standard export includes the
% full conference name, edition, location, dates, editors, series, volume, number,
% pages, publisher, DOI and URL. No authors, titles, venues or years were invented.
% Each biburl records its download source; timestamp, biburl and bibsource are
% retained and ignored by IEEEtran.bst. Raw downloads are in documentation/references/dblp/.
%
% CHANGES TO DOWNLOADS
% 1. Citation keys match paper.tex: for example DBLP:conf/aistats/McMahanMRHA17
%    becomes mcmahan2017federated.
% 2. In inproceedings entries, editor, publisher, series and volume have an x prefix
%    so IEEEtran ignores them without deleting the original metadata. Article volume,
%    issue and pages are retained. Printing the suppressed fields added a ninth page.
%    To restore them: sed -i -E 's/^(\s+)x(editor|publisher|series|volume)/\1\2/' references.bib
% 3. Typography corrections preserve names and capitalization:
%    - Seven occurrences of {-} in names become -, preserving initials such as
%      H.-P. Kriegel and L.-P. Morency rather than H. Kriegel and L. Morency.
%    - Braces group Blaise {Ag{\"{u}}era y Arcas} as a compound surname.
%    - Braces protect {PeFAD}, {FedProto}, {MaskGIT}, {FedBN} and Non-{IID}.
%    - {SCAFFOLD:} becomes {SCAFFOLD}: so the next title word is capitalized.
%
% KNOWN DIFFERENCES FROM EARLIER HAND-CURATED RECORDS
% DBLP lists Brendan McMahan in mcmahan2017federated, producing B. McMahan; PMLR
% lists H. Brendan McMahan. The downloaded form is retained. DBLP lists Aaron J.
% Elmore for paparrizos2022vus, while the PVLDB article omits the middle initial.
% The CoRR record for liang2020lgfedavg has the five v1 authors; arXiv v3 has eight,
% adding Allen, Auerbach and Brent. These are recorded source differences.
%
% STYLE
% Use IEEEtran with \bstctlcite{IEEEexample:BSTcontrol} immediately after
% \begin{document}. The control entry omits URLs and abbreviates long author lists.
% Without it, the bibliography grows. Acronym braces also survive a .bst change.

@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLuse_forced_etal  = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal  = "1",
  CTLuse_url          = "no",
  CTLuse_alt_spacing  = "yes",
  CTLdash_repeated_names = "no"
}

